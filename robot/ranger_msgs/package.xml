<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- RANGER V3 · F13 (ADR-0020): reading messages for /ranger/{radiation,air_quality,imu_baro} -->
<package format="3">
  <name>ranger_msgs</name>
  <version>0.1.0</version>
  <description>RANGER reading messages: radiation, air quality, IMU/baro. Each carries a header stamp and the robot's provenance claim.</description>
  <maintainer email="maintainer@example.com">Brian Kipruto</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
