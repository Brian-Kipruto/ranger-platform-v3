# ─── RANGER V3: Environment variables (example) ───
# Copy to .env and fill in real values. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=ranger_backend.settings.development
DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=ranger_v3
POSTGRES_USER=ranger
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SIGNING_KEY=change-me-different-from-django-secret

# CORS (frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
